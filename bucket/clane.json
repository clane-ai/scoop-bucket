{
  "version": "0.1.64",
  "description": "The Clane CLI - Clane AI in your terminal.",
  "homepage": "https://clane.sh",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://clane.sh/cli/releases/0.1.64/clane-0.1.64-windows-x86_64.zip",
      "hash": "8ab3bd949904f750d76f4b39e7d13955dd3463e61a904ad6f0731e01939945ca"
    }
  },
  "bin": "clane.exe",
  "post_install": [
    "# Scoop owns this install, so Clane reports updates instead of replacing itself.",
    "$dir = Join-Path $env:ProgramData 'Clane'",
    "New-Item -ItemType Directory -Path $dir -Force | Out-Null",
    "Set-Content -Path (Join-Path $dir 'update-mode') -Value 'notify'"
  ],
  "checkver": {
    "url": "https://clane.sh/cli/stable/manifest.json",
    "jsonpath": "$.version"
  }
}
